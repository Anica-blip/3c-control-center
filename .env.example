# Repo path: .env.example
# ---------------------------------------------------------------------------
# 3C Control Center - environment variable NAMES (no values in this file).
# Copy to .env for local work. The real .env is never committed (see .gitignore).
# In production (Vercel project "3c-control-center") set the same names under
# Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project "3C Control Center": address and the public (browser) keys.
# These two keys are meant to be visible in the browser; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Display settings used by the login screen (both have built-in defaults).
REACT_APP_AUTHORIZED_USER=
REACT_APP_TIMEZONE=

# Runner secrets (service-role key, Telegram bot token, database URL) do NOT belong
# in this app's .env. They live only in the service that needs them
# (for the Aurion bot: Cloudflare Worker "aurion-bot", Settings > Variables and Secrets).
